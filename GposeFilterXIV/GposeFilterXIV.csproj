<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.1.0.0</Version>
    <Description>Keeps one of the game's GPose color filters on outside of GPose.</Description>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Sans ça, la version des fichiers porte le hash du commit d'avant (la compilation précède le commit « Version X.Y.Z »). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Pas la documentation XML de KamiToolKit dans le paquet (450 Ko inutiles en jeu) ; les .pdb restent. -->
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GposeFilterXIV.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fenêtre au style du jeu (éléments d'interface natifs), MIT, sous-module figé sur le commit b4b7cab. -->
    <ProjectReference Include="..\KamiToolKit\KamiToolKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Icône de la liste des plugins de Dalamud : pour une version de dev, il la lit dans images\ à côté de la DLL. -->
    <None Include="..\images\icon.png" Link="images\icon.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\images\icon.png')" />
  </ItemGroup>
</Project>
